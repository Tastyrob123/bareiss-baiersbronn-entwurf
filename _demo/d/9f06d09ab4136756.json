 "", "ober": "", "gleich": 1}], "fotos": [{"b": "k-schiff", "n": 0, "alt": "", "zu": "", "klein": "assets/img/k-schiff-640.webp?v=1", "neu": false}]}, {"h": "da100cfe6d", "n": 0, "titel": "Ein Baumhaus wie eine Trommel.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "c9f6295afe", "n": 0, "tag": "h2", "t": "Ein Baumhaus wie eine Trommel.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "7878b62960", "n": 0, "tag": "p", "t": "Von außen", "zu": "", "vor": "Ein Baumhaus wie eine Trommel.", "ober": "", "gleich": 1}, {"h": "4ada55957a", "n": 0, "tag": "p", "t": "Hoch oben in den Wipfeln, rund wie eine riesige Trommel und ringsum mit Fensterluken, die denen von Schiffen ähnlich sind.", "zu": "", "vor": "Von außen", "ober": "Ein Baumhaus wie eine Trommel.", "gleich": 1}, {"h": "a701020348", "n": 0, "tag": "p", "t": "Von innen", "zu": "", "vor": "Von außen", "ober": "Ein Baumhaus wie eine Trommel.", "gleich": 1}, {"h": "d4c4bbab08", "n": 0, "tag": "p", "t": "So weiß man im Inneren nie ganz genau, ob man gerade im Himmel oder auf dem Meer unterwegs ist.", "zu": "", "vor": "Von innen", "ober": "Ein Baumhaus wie eine Trommel.", "gleich": 1}], "fotos": [{"b": "u-baumhaus", "n": 0, "alt": "Das runde Baumhaus im Waldpark", "zu": "", "klein": "assets/img/u-baumhaus-640.webp?v=1", "neu": false}, {"b": "k-baumhaus", "n": 0, "alt": "Zwei Kinder in roten Schlafsäcken im Baumhaus", "zu": "", "klein": "assets/img/k-baumhaus-640.webp?v=1", "neu": false}]}, {"h": "b5139be092", "n": 0, "titel": "Reiterhöfle und Tierwelt.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "ac2aadc9e2", "n": 0, "tag": "h2", "t": "Reiterhöfle und Tierwelt.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "cafa622e98", "n": 0, "tag": "p", "t": "Staubige Stiefel, glänzende Augen, glückseliges Staunen: Auf dem Bareiss Reiterhöfle bieten sich vielfältige Möglichkeiten, sich den Ponys und Pferden Schritt für Schritt anzunähern.", "zu": "", "vor": "