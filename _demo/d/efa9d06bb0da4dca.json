h": 3}, {"h": "779fcf9687", "n": 0, "tag": "a", "t": "Zimmer buchen", "zu": "", "vor": "Anreise", "ober": "", "gleich": 2}], "fotos": []}, {"h": "5faf2e29b1", "n": 0, "titel": "Geschichte und Gegenwart, lebendig gestaltet.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "07e9ca01d0", "n": 0, "tag": "p", "t": "Rund ums Bareiss", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "4de9c79ee6", "n": 0, "tag": "h1", "t": "Geschichte und Gegenwart, lebendig gestaltet.", "zu": "", "vor": "Rund ums Bareiss", "ober": "", "gleich": 1}, {"h": "37439143e8", "n": 0, "tag": "p", "t": "Der Forellenhof Buhlbach, unser Morlokhof und die Wanderhütte Sattelei sind lebendige Beispiele dafür, wie der sinnvolle Wandel von der Tradition in die Moderne gelingt.", "zu": "", "vor": "Geschichte und Gegenwart, lebendig gestaltet.", "ober": "", "gleich": 1}], "fotos": [{"b": "tal-buhlbach", "n": 0, "alt": "Das Tal bei Buhlbach von oben, Wiesen, Wald und der Forellenhof", "zu": "", "klein": "assets/img/tal-buhlbach-640.webp?v=1", "neu": false}]}, {"h": "ec26e85a9b", "n": 0, "titel": "Der Forellenhof Buhlbach.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "7ef816765b", "n": 0, "tag": "h2", "t": "Der Forellenhof Buhlbach.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "a9e73c1ad8", "n": 0, "tag": "p", "t": "Der Forellenhof liegt in traumhafter Lage inmitten des Landschaftsschutzgebiets Buhlbach, in fußläufiger Entfernung zum Hotel. Aus dem »Fischerstüble« von einst ist 2017 nach umfassenden Umbauarbeiten ein stattliches Schwarzwaldhaus geworden.", "zu": "", "vor": "Der Forellenhof Buhlbach.", "ober": "", "gleich": 1}, {"h": "e2f10d13e7", "n": 0, "tag": "p", "t": "In der Forellenstube, der Buhlbachstube und auf der großzügigen Sonnenterrasse gibt es frische Forellenspezialitäten und ein zünftiges Vesper. Im Forellenlädle Forellen frisch aus dem Rauch.", "zu": "", "vor": "Der Forellenhof Buhlbach.", "ober": "", "gleich": 1}, {"h": "14cf81a813", "n": 0, "tag": "h3", "t": "Öffnungszeiten", "zu": "", "vor": "Der Forellenhof Buhlbach.", "ober": "", "gleich": 2}, {"h": "ef50ca719f", "n": 0, "tag": "p", "t": "Gaststuben täglich 11.30 bis 17.30 Uhr, freitags bis 22.00 Uhr; freitags ab 19.00 Uhr mit Reservierung unter +49 7442 47-0.", "zu": "", "vor": "Öffnungszeiten", "ober": "", "gleich": 1}, {"h": "157b4b7d72", "n": 0, "tag": "p", "t": "Forellenlädle Montag bis Freitag 9.00 bis 12.00 Uhr.", "zu": "", "vor": "Öffnungszeiten", "ober": "", "gleich": 1}], "fotos": [{"b": "tal-forellenhof", "n": 0, "alt": "Der Forellenhof Buhlbach mit Sonnenterrasse", "zu": "", "klein": "assets/img/tal-forellenhof-640.webp?v=1", "neu": false}, {"b": "u-forellenhof2", "n": 0, "alt": "Der Forellenhof im Sommer, an den Hang gebaut", "zu": "", "klein": "assets/img/u-forellenhof2-640.webp?v=1", "neu": false}, {"b": "tal-forellenhof-oben", "n": 0, "alt": "Der Forellenhof von oben mit Teichen und Fließkanälen", "zu": "", "klein": "assets/img/tal-forellenhof-oben-640.webp?v=1", "neu": false}]}, {"h": "09b5c11c31", "n": 0, "titel": "Vom Ei bis zur Veredelung, alles vor Ort.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "748c2765d6", "n": 0, "tag": "h2", "t": "Vom Ei bis zur Veredelung, alles vor Ort.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "fbbe6c1a6c", "n": 0, "tag": "p", "t": "Die Anlage speist sich direkt aus der natürlichen Quelle des »Leinbächle«. Ausgebildete Fischwirte sorgen für Gewässer und Bestand und geben bei Führungen Einblick in Zucht, Wasseraufbereitung und Rückführung.", "zu": "", "vor": "Vom Ei bis zur Veredelung, alles vor Ort.", "ober": "", "gleich": 1}, {"h": "21ad732d16", "n": 0, "tag": "span", "t": "Becken und Teiche", "zu": "", "vor": "Vom Ei bis zur Veredelung, alles vor Ort.", "ober": "", "gleich": 1}, {"h": "88c6b7ccc4", "n": 0, "tag": "b", "t": "8", "zu": "", "vor": "Becken und Teiche", "ober": "Vom Ei bis zur Veredelung, alles vor Ort.", "gleich": 1}, {"h": "bc2ae3fcfa", "n": 0, "tag": "span", "t": "Fließkanäle", "zu": "", "vor": "8", "ober": "", "gleich": 1}, {"h": "085503e4bc", "n": 0, "tag": "b", "t": "4", "zu": "", "vor": "Fließkanäle", "ober": "8", "gleich": 1}, {"h": "24cb54cff1", "n": 0, "tag": "span", "t": "Arten", "zu": "", "vor": "4", "ober": "", "gleich": 1}, {"h": "e93f7020f5", "n": 0, "tag": "b", "t": "Regenbogen-, Lachs- und Goldforelle, Saibling", "zu": "", "vor": "Arten", "ober": "4", "gleich": 1}, {"h": "581ef4d720", "n": 0, "tag": "span", "t": "Geheizt mit", "zu": "", "vor": "Regenbogen-, Lachs- und Goldforelle, Saibling", "ober": "", "gleich": 1}, {"h": "ea5f820c34", "n": 0, "tag": "b", "t": "Pellets, gebaut aus regionalem Holz", "zu": "", "vor": "Geheizt mit", "ober": "Regenbogen-, Lachs- und Goldforelle, Saibling", "gleich": 1}, {"h": "9dd490d156", "n": 0, "tag": "p", "t": "»Der Forellenhof ist für meine Familie und unsere Mitarbeitenden ein sichtbares Stück Zukunftsvision.«", "zu": "", "vor": "Pellets, gebaut aus regionalem Holz", "ober": "", "gleich": 1}, {"h": "4cdcb5440c", "n": 0, "tag": "p", "t": "Hannes Bareiss", "zu": "", "vor": "Pellets, gebaut aus regionalem Holz", "ober": "", "gleich": 1}], "fotos": []}, {"h": "c89a1be8da", "n": 0, "titel": "Der Morlokhof, das Juwel am Berg.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "7f9a12d0f4", "n": 0, "tag": "h2", "t": "Der Morlokhof, das Juwel am Berg.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "5cf45c54fe", "n": 0, "tag": "p", "t": "Anno 1789 erbaute Johann Georg Morlok den Hof hoch oben am Rande Mitteltals; er zählt zu den ältesten und am besten erhaltenen Bauernhöfen im oberen Murgtal. Seit 1610 sind die Morloks in den Kirchenbüchern nachgewiesen, und sie galten als Wunderheiler.", "zu": "", "vor": "Der Morlokhof, das Juwel am Berg.", "ober": "", "gleich": 1}, {"h": "b61eae1f96", "n": 0, "tag": "p", "t": "Bei der Restaurierung fanden die Arbeiter über 130 handschriftliche Aufzeichnungen, Briefe und Seiten aus Arzneibüchern. Hermann Bareiss erwarb den Hof 2003; heute geben Stuben, Heuboden und Bauerngarten die Kulisse für Führungen und Feste.", "zu": "", "vor": "Der Morlokhof, das Juwel am Berg.", "ober": "", "gleich": 1}, {"h": "1b373d413d", "n": 0, "tag": "h3", "t": "Besuch", "zu": "", "vor": "Der Morlokhof, das Juwel am Berg.", "ober": "", "gleich": 1}, {"h": "17a150b44f", "n": 0, "tag": "p", "t": "Der Morlokhof ist nur im Rahmen von Veranstaltungen geöffnet. Anfragen an die Reservierung unter +49 7442 47-0.", "zu": "", "vor": "Besuch", "ober": "", "gleich": 1}], "fotos": [{"b": "tal-morlokhof", "n": 0, "alt": "Der Morlokhof mit Backhäusle", "zu": "", "klein": "assets/img/tal-morlokhof-640.webp?v=1", "neu": false}, {"b": "u-morlok-stube", "n": 0, "alt": "Die grüne Stube im Morlokhof", "zu": "", "klein": "assets/img/u-morlok-stube-640.webp?v=1", "neu": false}, {"b": "u-morlok-heuboden", "n": 0, "alt": "Kaffeetafel auf dem Heuboden", "zu": "", "klein": "assets/img/u-morlok-heuboden-640.webp?v=1", "neu": false}]}, {"h": "3a658264d7", "n": 0, "titel": "Die Wanderhütte Sattelei.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "3a9f6a6c88", "n": 0, "tag": "h2", "t": "Die Wanderhütte Sattelei.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "e3d989ec1c", "n": 0, "tag": "p", "t": "Auf 706 Metern zwischen Mitteltal und dem Tonbachtal, mitten im Baiersbronner Wanderhimmel. Vom Haus aus ist die Sattelei bei mittlerem Schritttempo in einer guten Dreiviertelstunde erreicht, ganzjährig geöffnet.", "zu": "", "vor": "Die Wanderhütte Sattelei.", "ober": "", "gleich": 1}, {"h": "e83e24fdf1", "n": 0, "tag": "p", "t": "Hausgemachtes Griebenschmalz mit Zwiebeln und Kräutern, Sülze vom Mitteltaler Weiderind, Murgtaler Wurstsalat, dazu ein klassisches Viertele oder ein frisch gezapftes Pils.", "zu": "", "vor": "Die Wanderhütte Sattelei.", "ober": "", "gleich": 1}, {"h": "14cf81a813", "n": 1, "tag": "h3", "t": "Öffnungszeiten", "zu": "", "vor": "Die Wanderhütte Sattelei.", "ober": "", "gleich": 2}, {"h": "808a96925b", "n": 0, "tag": "p", "t": "Montag bis Samstag 11.00 bis 17.00 Uhr, Sonntag 11.00 bis 21.30 Uhr. Für Feste auch abends.", "zu": "", "vor": "Öffnungszeiten", "ober": "", "gleich": 1}, {"h": "ff3e450c71", "n": 0, "tag": "p", "t": "48°31’13’’N · 08°21’09’’E", "zu": "", "vor": "Öffnungszeiten", "ober": "", "gleich": 1}], "fotos": [{"b": "tal-sattelei", "n": 0, "alt": "Die Wanderhütte Sattelei mit Terrasse unter Tannen", "zu": "", "klein": "assets/img/tal-sattelei-640.webp?v=1", "neu": false}]}, {"h": "8b47741b7a", "n": 0, "titel": "Der Nordschwarzwald, ein Naturparadies.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "88cd18ac14", "n": 0, "tag": "h2", "t": "Der Nordschwarzwald, ein Naturparadies.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "b710809d34", "n": 0, "tag": "p", "t": "Endlose Wälder, dunkle Karseen, Moore, moosbedeckte Felsen: Zwischen Schwarzwaldhochstraße und Murgtal ist die Natur auf etwa 10.000 Hektar sich selbst überlassen.", "zu": "", "vor": "Der Nordschwarzwald, ein Naturparadies.", "ober": "", "gleich": 1}, {"h": "67b70f4b0d", "n": 0, "tag": "p", "t": "Genießerpfade, Erlebniswanderungen, Heilklimawege, Trekkingtouren: Der Baiersbronner Wanderhimmel erschließt den Schwarzwald auf einem Wegenetz von 550 Kilometern.", "zu": "", "vor": "Der Nordschwarzwald, ein Naturparadies.", "ober": "", "gleich": 1}, {"h": "d019ea07ea", "n": 0, "tag": "span", "t": "Nationalpark Schwarzwald", "zu": "", "vor": "Der Nordschwarzwald, ein Naturparadies.", "ober": "", "gleich": 1}, {"h": "f702528644", "n": 0, "tag": "b", "t": "10.000 Hektar", "zu": "", "vor": "Nationalpark Schwarzwald", "ober": "Der Nordschwarzwald, ein Naturparadies.", "gleich": 1}, {"h": "f841f88aa9", "n": 0, "tag": "span", "t": "Baiersbronner Wanderhimmel", "zu": "", "vor": "10.000 Hektar", "ober": "", "gleich": 1}, {"h": "76b16cc423", "n": 0, "tag": "b", "t": "550 Kilometer", "zu": "", "vor"