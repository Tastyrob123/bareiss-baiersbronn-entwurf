leich": 3}, {"h": "779fcf9687", "n": 0, "tag": "a", "t": "Zimmer buchen", "zu": "", "vor": "Anreise", "ober": "", "gleich": 2}], "fotos": []}, {"h": "564d7ed01c", "n": 0, "titel": "Mit dem Herzen dabei.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "9adf9a1d1e", "n": 0, "tag": "p", "t": "Wir Bareissianer", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "debb5971ef", "n": 0, "tag": "h1", "t": "Mit dem Herzen dabei.", "zu": "", "vor": "Wir Bareissianer", "ober": "", "gleich": 1}, {"h": "fc1ffec840", "n": 0, "tag": "p", "t": "Wir Bareissianer leben unsere Leidenschaft und wir lieben, was wir tun. Mit dem Herzen dabei sind unsere vier Worte für das Gefühl, genau am richtigen Ort und dort am perfekten Platz zu sein.", "zu": "", "vor": "Mit dem Herzen dabei.", "ober": "", "gleich": 1}, {"h": "7c1c5a9959", "n": 0, "tag": "a", "t": "Stellenangebote", "zu": "", "vor": "Mit dem Herzen dabei.", "ober": "", "gleich": 1}], "fotos": [{"b": "r-tisch", "n": 0, "alt": "Ein gedeckter Tisch im Restaurant Bareiss", "zu": "", "klein": "assets/img/r-tisch-640.webp?v=1", "neu": false}]}, {"h": "028f60fcdb", "n": 0, "titel": "Hier lernt jeder alles.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "181031c362", "n": 0, "tag": "h2", "t": "Hier lernt jeder alles.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "f23795eacb", "n": 0, "tag": "p", "t": "Wir sind stolz auf unsere Auszubildenden. Denn bei uns im Bareiss leisten sie schon etwas Außergewöhnliches. Vom Zimmerservice bis zur Bar, von den À-la-carte-Restaurants bis zur Wanderhütte Sattelei, von Veranstaltungen bis zu den Backoffice-Bereichen – hier lernt jeder alles. Es ist die unglaubliche Vielfalt, die das Bareiss als erste Station für Berufseinsteiger so wertvoll macht.", "zu": "", "vor": "Hier lernt jeder alles.", "ober": "", "gleich": 1}, {"h": "68e0a87d34", "n": 0, "tag": "p", "t": "Ob Sie Ihre Ausbildung bei uns absolvieren oder ob wir eine Stufe auf Ihrem Weg nach oben sind: Den Namen Bareiss im Lebenslauf vorweisen zu können, ist eine erstklassige Referenz. Bareissianer machen ihren Weg. Das zeigt sich jeden Tag von Neuem.", "zu": "", "vor": "Hier lernt jeder alles.", "ober": "", "gleich": 1}, {"h": "0942f82bc5", "n": 0, "tag": "h3", "t": "»Die Vielfalt und die Abwechslung in der Ausbildung im Bareiss sind unerreicht.«", "zu": "", "vor": "Hier lernt jeder alles.", "ober": "", "gleich": 1}, {"h": "7e8fcf8190", "n": 0, "tag": "p", "t": "Peter, Restaurantfachmann im ersten Lehrjahr", "zu": "", "vor": "»Die Vielfalt und die Abwechslung in der Ausbildung im Bareiss sind un", "ober": "", "gleich": 1}], "fotos": [{"b": "r-pass", "n": 0, "alt": "Am Pass der Küche des Restaurants Bareiss", "zu": "", "klein": "assets/img/r-pass-640.webp?v=1", "neu": false}, {"b": "u-kamin-service", "n": 0, "alt": "Service in der Kaminstube", "zu": "", "klein": "assets/img/u-kamin-service-640.webp?v=1", "neu": false}, {"b": "r-zwei2", "n": 0, "alt": "Zwei Köche des Restaurants Bareiss", "zu": "", "klein": "assets/img/r-zwei2-640.webp?v=1", "neu": false}]}, {"h": "abff30bfea", "n": 0, "titel": "Ausgezeichnet als Top-Arbeitgeber.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "53b764c110", "n": 0, "tag": "h2", "t": "Ausgezeichnet als Top-Arbeitgeber.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "ca68b61bfb", "n": 0, "tag": "p", "t": "Lebendiges Miteinander, individuelle Mitarbeiterförderung, gelebte Kultur: Unser Bareiss ist als einer von fünf Preisträgern in der Kategorie »Image & Innovationskraft« als Top-Arbeitgeber prämiert worden.", "zu": "", "vor": "Ausgezeichnet als Top-Arbeitgeber.", "ober": "", "gleich": 1}, {"h": "ebdbfd44a9", "n": 0, "tag": "p", "t": "Eine starke Markenidentität und die Identifikation der Mitarbeitenden mit unserem Haus, die Bareiss Akademie und das gemeinsam entwickelte Leitbild haben wesentlich zu diesem hervorragenden Ergebnis beigetragen. Zudem wurden das Miteinander über das rein Berufliche hinaus, das Ferienprogramm für Mitarbeitende ebenso wie die gemeinsamen Aktivitäten und Events gelobt.", "zu": "", "vor": "Ausgezeichnet als Top-Arbeitgeber.", "ober": "", "gleich": 1}, {"h": "14781f3a42", "n": 0, "tag": "h3", "t": "Image & Innovationskraft", "zu": "", "vor": "Ausgezeichnet als Top-Arbeitgeber.", "ober": "", "gleich": 1}, {"h": "551fdfd933", "n": 0, "tag": "p", "t": "Das Ranking basiert auf einer wissenschaftlich fundierten Branchenstudie der ahgz und der Hochschule für Wirtschaft und Recht (HWR) in Berlin.", "zu": "", "vor": "Image & Innovationskraft", "ober": "", "gleich": 1}], "fotos": [{"b": "g-britta-hannes", "n": 0, "alt": "Britta und Hannes Bareiss", "zu": "", "klein": "assets/img/g-britta-hannes-640.webp?v=1", "neu": false}, {"b": "r-team", "n": 0, "alt": "Hannes Bareiss, Claus-Peter Lumpp und Thomas Brandt im Restaurant Bareiss", "zu": "", "klein": "assets/img/r-team-640.webp?v=1", "neu": false}]}, {"h": "e19c6d4180", "n": 0, "titel": "Was wir Ihnen bieten.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "82d0862ee8", "n": 0, "tag": "h2", "t": "Was wir Ihnen bieten.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "914c15b37c", "n": 0, "tag": "li", "t": "Vergütung nach Tarifvertrag", "zu": "", "vor": "Was wir Ihnen bieten.", "ober": "", "gleich": 1}, {"h": "386fa23c5c", "n": 0, "tag": "li", "t": "Individuelle fachliche und persönliche Weiterbildung in unserer Bareiss Akademie", "zu": "", "vor": "Vergütung nach Tarifvertrag", "ober": "Was wir Ihnen bieten.", "gleich": 1}, {"h": "dc4ee8c6bf", "n": 0, "tag": "li", "t": "Regelmäßige Feedback- und Entwicklungsgespräche mit persönlicher Karriereplanung", "zu": "", "vor": "Individuelle fachliche und persönliche Weiterbildung in unserer Bareis", "ober": "Was wir Ihnen bieten.", "gleich": 1}, {"h": "7e6408689b", "n": 0, "tag": "li", "t": "Betriebliche Altersversorgung sowie E-Bike-Leasing, Geschäftswagen per Gehaltsumwandlung und Ticket-Plus-Karte"